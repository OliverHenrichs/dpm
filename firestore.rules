rules_version = '2';

// Security rules for list sharing (src/firebase/). Deploy with
// `npm run rules:deploy`; test with `npm run test:rules`.
//
// Subscribers never sign in: whoever knows a share code can read that list.
// Publishers sign in anonymously (no account, just a stable id), and every
// list has an owner record under the same code in `sharedListOwners`, which
// nobody can read. Only the owner on record may update or delete a list.
// Ownership moves to whoever presents the list's share key, which the
// publisher's phone holds and editable exports carry.
//
// - nothing can enumerate either collection; a list is read by its code only;
// - a write must be a well-formed shared list stored under its own code,
//   carrying the app token;
// - nothing outside these two collections can be read or written at all,
//   except a shared list's suggestions, handover offers and subscriptions
//   (below).
//
// Suggestions: a publisher can let subscribers suggest new patterns
// (`list.suggestions`: a daily limit, counted for the whole list or per
// subscriber), and with `edits` changes to existing ones, counted alike. A subscriber signs in anonymously to suggest, so every
// suggestion carries an author id the publisher can mute. The limit is
// counted here, not in the app: each suggestion is written together with
// today's counter (UTC days), and the counter may only go up by one, with a
// suggestion that did not exist before, up to the limit. Only the owner reads
// suggestions, counters' listings and subscriber records; a subscriber may
// read today's counter and their own record, so the app can say why it cannot send.
//
// Members only: a publisher can close a list (`list.membersOnly`), so only
// subscribers they have let in may read it. A subscriber signs in anonymously
// and asks to join (`subscribers/{uid}` with `membership: 'requested'`); the
// owner sets `member` or `declined`. Members, and the owner, read the list as
// before; everyone else is refused, which tells the app the list is closed
// (a code that does not exist still reads as not-found).
//
// Handing over: the owner can give the list to someone who follows it. The
// owner creates a one-time offer, `handovers/{code}`, named by a 10-character
// code they pass on in person; whoever presents that code within 7 days
// accepts it and, in the same write, becomes the owner on record with a new
// key, which locks the old owner's key out. The list keeps its share code, so
// everyone subscribed keeps following it. The old owner can still see the
// accepted offer, which is how their app learns to follow instead.
//
// Blocked: the operator can block one anonymous id (`blockedUsers/{uid}`,
// tools/data-removal). It may then not publish, suggest, ask to join or
// take a list over.
//
// Subscriber count: every subscribing phone keeps a record under the list,
// `subscriptions/{id}`, named by a random id it keeps for that list (not its
// anonymous user id; subscribing to an open list never signs in), holding
// only when it last synced the list. Only the owner may list them, which is
// how the publisher counts them; nobody can read a single one. The id is the
// phone's secret, so whoever holds it may refresh or delete that record.
//
// Reports: anyone who follows a list can report it to the operator
// (TERMS_OF_USE.md §4), signed in anonymously. A report lives outside the
// list, `reports/{shareCode}_{uid}`, so it outlives the list's removal and
// the publisher cannot see or delete it; one per list and reporter, which
// sending again replaces. Nobody reads reports but the Admin SDK
// (tools/data-removal).
//
// The app token is compared by its SHA-256, so the repository (public) holds
// only the hash. Rotating it means a new FIREBASE_APP_TOKEN in .env and in
// every EAS environment, a rebuild, and a new hash below; old builds stop
// being able to publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // FirebaseListService.generateShareCode: 8 characters, 0-9 and A-Z.
    function isShareCode(code) {
      return code.matches('^[0-9A-Z]{8}$');
    }

    function signedIn() {
      return request.auth != null;
    }

    // An installation the operator has blocked (tools/data-removal,
    // `block-user`): it may no longer publish, suggest or ask to join. It can
    // still unpublish its own lists. Nobody reads `blockedUsers`; only the
    // Admin SDK writes it.
    function notBlocked() {
      return !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    function ownerPath(code) {
      return /databases/$(database)/documents/sharedListOwners/$(code);
    }

    function listPath(code) {
      return /databases/$(database)/documents/sharedLists/$(code);
    }

    function hasAppToken(data) {
      return data.appToken is string
        && hashing.sha256(data.appToken).toHexString().lower()
          == 'ee5aebaefc65b937e5a9d46f6500688554af84a8d0011f25d835bfb36e90e05b';
    }

    function suggestionPath(code, id) {
      return /databases/$(database)/documents/sharedLists/$(code)/suggestions/$(id);
    }

    function counterPath(code, id) {
      return /databases/$(database)/documents/sharedLists/$(code)/suggestionCounters/$(id);
    }

    function subscriberPath(code, uid) {
      return /databases/$(database)/documents/sharedLists/$(code)/subscribers/$(uid);
    }

    function handoverPath(code, token) {
      return /databases/$(database)/documents/sharedLists/$(code)/handovers/$(token);
    }

    // HandoverService.generateHandoverCode: 10 characters, 0-9 and A-Z.
    function isHandoverCode(token) {
      return token is string && token.matches('^[0-9A-Z]{10}$');
    }

    function isMuted(code, uid) {
      return exists(subscriberPath(code, uid))
        && get(subscriberPath(code, uid)).data.get('status', '') == 'muted';
    }

    // A subscriber the owner has let into a members-only list.
    function isMember(code) {
      return signedIn()
        && exists(subscriberPath(code, request.auth.uid))
        && get(subscriberPath(code, request.auth.uid)).data.get('membership', '')
          == 'member';
    }

    // The owner on record. Subcollection reads and writes are checked
    // against it; the app re-confirms ownership with the key when refused.
    function isOwner(code) {
      return signedIn()
        && get(ownerPath(code)).data.ownerUid == request.auth.uid;
    }

    // The day of `request.time` in UTC, as days since the epoch: what a
    // suggestion counter is named by.
    function today() {
      return string(int(math.floor(request.time.toMillis() / 86400000)));
    }

    // `IPatternList.suggestions`: present means suggestions are allowed.
    function isSuggestionPolicy(policy) {
      return policy is map
        && policy.keys().hasOnly(['dailyLimit', 'per', 'edits'])
        && policy.keys().hasAll(['dailyLimit', 'per'])
        && policy.dailyLimit is int
        && policy.dailyLimit >= 1
        && policy.dailyLimit <= 100
        && policy.per in ['list', 'subscriber']
        && (!('edits' in policy) || policy.edits == true);
    }

    match /sharedLists/{shareCode} {

      // SharedListDocument, exactly as publishList() writes it. The share
      // key must never be in it: subscribers read this document. What is
      // inside each figure is not checked here (rules cannot loop over a
      // list); subscribers' apps check it (validateSharedList).
      function isSharedList(data) {
        return data.keys().hasOnly(
            ['list', 'patterns', 'publisherVersion', 'publishedAt', 'appToken'])
          && data.keys().hasAll(
            ['list', 'patterns', 'publisherVersion', 'publishedAt', 'appToken'])
          && data.list is map
          && data.list.id is string
          && data.list.id.size() > 0
          && data.list.id.size() <= 64
          && data.list.name is string
          && data.list.name.size() <= 200
          && data.list.shareCode == shareCode
          && !('readonly' in data.list)
          && !('shareKey' in data.list)
          && (!('suggestions' in data.list)
            || isSuggestionPolicy(data.list.suggestions))
          && (!('membersOnly' in data.list) || data.list.membersOnly == true)
          && data.patterns is list
          && data.patterns.size() <= 5000
          && data.publisherVersion is int
          && data.publishedAt is string
          && data.publishedAt.size() <= 40;
      }

      // Open lists to anyone with the code; members-only ones to members and
      // the owner. A missing document reads as not-found, so a refusal means
      // "members only", never "no such code".
      allow get: if isShareCode(shareCode)
        && (resource == null
          || !resource.data.list.get('membersOnly', false)
          || isMember(shareCode)
          || isOwner(shareCode));
      allow list: if false;

      // publishList() writes the owner record and the list in one batch, so
      // the owner is checked as it stands once the batch has applied.
      allow create, update: if isShareCode(shareCode)
        && signedIn()
        && notBlocked()
        && hasAppToken(request.resource.data)
        && isSharedList(request.resource.data)
        && keepsListId()
        && getAfter(ownerPath(shareCode)).data.ownerUid == request.auth.uid;

      // A published list keeps its id: subscribers' phones store it under that
      // id, and a list that took another list's id could overwrite that list
      // on every phone following both.
      function keepsListId() {
        return resource == null
          || request.resource.data.list.id == resource.data.list.id;
      }

      // A delete carries no data, so the caller is compared with the owner on
      // record; unpublishList() first takes ownership with the key if needed.
      allow delete: if isShareCode(shareCode)
        && signedIn()
        && get(ownerPath(shareCode)).data.ownerUid == request.auth.uid;
    }

    match /sharedListOwners/{shareCode} {
      // `handover` names the offer a takeover accepts (below); only
      // acceptHandover() writes it.
      function isOwnerRecord(data) {
        return data.keys().hasOnly(['ownerUid', 'key', 'handover'])
          && data.keys().hasAll(['ownerUid', 'key'])
          && data.ownerUid == request.auth.uid
          && data.key is string
          && data.key.size() >= 32
          && data.key.size() <= 128
          && (!('handover' in data) || isHandoverCode(data.handover));
      }

      // The offer named by `token` exists, was still open before this write,
      // and is accepted by the caller in this same write. The list must
      // exist: a list taken down keeps an owner record nobody may claim.
      function acceptsOffer(token) {
        let path = handoverPath(shareCode, token);
        return exists(listPath(shareCode))
          && exists(path)
          && !('acceptedBy' in get(path).data)
          && getAfter(path).data.get('acceptedBy', '') == request.auth.uid;
      }

      // The record holds the key, so nobody may read it, owner included.
      allow read: if false;

      // A new list, or a list published before owner records existed. The
      // second is claimed by the first signed-in publish of it, which in the
      // app only its publisher's phone makes; a subscriber working outside
      // the app could claim it first. That window closes on the date below,
      // after which a list still without an owner can no longer be changed.
      allow create: if isShareCode(shareCode)
        && signedIn()
        && notBlocked()
        && isOwnerRecord(request.resource.data)
        && (!exists(listPath(shareCode))
          || request.time < timestamp.date(2027, 4, 1));

      // Same key: either nothing changes, or ownership moves to the caller
      // (the publisher after a reinstall, or on a new phone). A new key only
      // with a handover the caller accepts in the same write.
      // A blocked owner may still re-confirm itself, so it can unpublish.
      allow update: if signedIn()
        && (notBlocked() || resource.data.ownerUid == request.auth.uid)
        && isOwnerRecord(request.resource.data)
        && (request.resource.data.key == resource.data.key
          || ('handover' in request.resource.data
            && acceptsOffer(request.resource.data.handover)));

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /sharedLists/{shareCode}/suggestions/{suggestionId} {
      // A pattern as the suggest form builds it (NewPattern, URL videos
      // only). Its references are checked again when the publisher accepts it.
      function isSuggestedPattern(p) {
        return p is map
          && p.keys().hasOnly(['name', 'typeId', 'counts', 'level', 'rhythm',
            'prerequisites', 'description', 'tags', 'videoRefs', 'modifierRefs'])
          && p.keys().hasAll(['name', 'typeId', 'counts', 'prerequisites',
            'description', 'tags', 'videoRefs', 'modifierRefs'])
          && p.name is string
          && p.name.size() > 0
          && p.name.size() <= 100
          && p.typeId is string
          && p.typeId.size() <= 64
          && p.counts is int
          && p.counts >= 0
          && p.counts <= 1000
          && (!('level' in p) || (p.level is string && p.level.size() <= 32))
          && (!('rhythm' in p) || (p.rhythm is string && p.rhythm.size() <= 200))
          && p.description is string
          && p.description.size() <= 2000
          && p.prerequisites is list
          && p.prerequisites.size() <= 50
          && p.tags is list
          && p.tags.size() <= 20
          && p.videoRefs is list
          && p.videoRefs.size() <= 10
          && p.modifierRefs is list
          && p.modifierRefs.size() <= 50;
      }

      // A new figure, or a change to the figure `patternId` (`kind: 'edit'`),
      // which also carries the figure as the subscriber saw it (`base`).
      function isNewOrEdit(data) {
        return ('kind' in data)
          ? data.kind == 'edit'
            && data.patternId is int
            && data.patternId >= 0
            && isSuggestedPattern(data.base)
          : !('patternId' in data) && !('base' in data);
      }

      function isSuggestion(data) {
        return data.keys().hasOnly(
            ['authorUid', 'authorName', 'pattern', 'kind', 'patternId', 'base',
              'createdAt', 'appToken'])
          && data.keys().hasAll(['authorUid', 'pattern', 'createdAt', 'appToken'])
          && data.authorUid == request.auth.uid
          && (!('authorName' in data)
            || (data.authorName is string
              && data.authorName.size() > 0
              && data.authorName.size() <= 40))
          && data.createdAt == request.time
          && hasAppToken(data)
          && isSuggestedPattern(data.pattern)
          && isNewOrEdit(data);
      }

      function counterIdFor(policy) {
        return policy.per == 'subscriber'
          ? 'd' + today() + '_' + request.auth.uid
          : 'd' + today();
      }

      // Today's counter goes up by one in the same write, names this
      // suggestion, and stays within the limit.
      function isCounted(policy) {
        let path = counterPath(shareCode, counterIdFor(policy));
        let before = exists(path) ? get(path).data.count : 0;
        let after = getAfter(path).data;
        return after.count == before + 1
          && after.count <= policy.dailyLimit
          && after.last == suggestionId;
      }

      function mayCreate() {
        let list = get(listPath(shareCode)).data.list;
        let policy = list.get('suggestions', null);
        return policy != null
          && (!('kind' in request.resource.data)
            || policy.get('edits', false) == true)
          && !isMuted(shareCode, request.auth.uid)
          && (!list.get('membersOnly', false) || isMember(shareCode))
          && isCounted(policy);
      }

      allow get, list, delete: if isShareCode(shareCode) && isOwner(shareCode);
      allow create: if isShareCode(shareCode)
        && signedIn()
        && notBlocked()
        && isSuggestion(request.resource.data)
        && mayCreate();
      allow update: if false;
    }

    match /sharedLists/{shareCode}/suggestionCounters/{counterId} {
      function isCounter(data) {
        return data.keys().hasOnly(['count', 'last'])
          && data.keys().hasAll(['count', 'last'])
          && data.count is int
          && data.last is string
          && data.last.size() <= 64;
      }

      // Only today's counters, and only the list's or the caller's own: no
      // one can use up tomorrow's limit or another subscriber's.
      function isTodaysCounter() {
        return counterId == 'd' + today()
          || counterId == 'd' + today() + '_' + request.auth.uid;
      }

      // Every count is a suggestion by the caller created in the same write.
      function countsNewSuggestion(data) {
        let path = suggestionPath(shareCode, data.last);
        return !exists(path)
          && existsAfter(path)
          && getAfter(path).data.authorUid == request.auth.uid;
      }

      allow get: if signedIn();
      allow list, delete: if isShareCode(shareCode) && isOwner(shareCode);
      allow create: if signedIn()
        && isTodaysCounter()
        && isCounter(request.resource.data)
        && request.resource.data.count == 1
        && countsNewSuggestion(request.resource.data);
      allow update: if signedIn()
        && isTodaysCounter()
        && isCounter(request.resource.data)
        && request.resource.data.count == resource.data.count + 1
        && countsNewSuggestion(request.resource.data);
    }

    // The publisher's record of one subscriber, named by their anonymous id:
    // a mute (`status: 'muted'`), a membership of a members-only list
    // (`membership`), or both, with the name they gave.
    match /sharedLists/{shareCode}/subscribers/{uid} {
      function isSubscriberRecord(data) {
        return data.keys().hasOnly(['status', 'membership', 'name', 'updatedAt'])
          && data.keys().hasAll(['updatedAt'])
          && (('status' in data) || ('membership' in data))
          && (!('status' in data) || data.status in ['muted'])
          && (!('membership' in data)
            || data.membership in ['requested', 'member', 'declined'])
          && data.updatedAt == request.time
          && (!('name' in data)
            || (data.name is string && data.name.size() <= 40));
      }

      function isMembersOnly() {
        return exists(listPath(shareCode))
          && get(listPath(shareCode)).data.list.get('membersOnly', false) == true;
      }

      // A subscriber asking to join a members-only list: only for themselves,
      // only `requested`, and only once. A record that already has a
      // membership (asked, let in, declined) is the owner's to change.
      function isJoinRequest() {
        let data = request.resource.data;
        return request.auth.uid == uid
          && isMembersOnly()
          && isSubscriberRecord(data)
          && data.membership == 'requested'
          && (resource == null
            ? !('status' in data)
            : !('membership' in resource.data)
              && data.diff(resource.data).affectedKeys()
                .hasOnly(['membership', 'name', 'updatedAt']));
      }

      allow get: if signedIn()
        && (request.auth.uid == uid || isOwner(shareCode));
      allow list, delete: if isShareCode(shareCode) && isOwner(shareCode);
      allow create, update: if isShareCode(shareCode)
        && signedIn()
        && ((isOwner(shareCode) && isSubscriberRecord(request.resource.data))
          || (isJoinRequest() && notBlocked()));
    }

    // A handover offer, named by its code: the owner's to create and withdraw,
    // the code holder's to accept once, within 7 days. The owner who made it
    // still reads it after the handover; nobody else ever does.
    match /sharedLists/{shareCode}/handovers/{token} {
      function isOffer(data) {
        return data.keys().hasOnly(['fromUid', 'offeredAt'])
          && data.keys().hasAll(['fromUid', 'offeredAt'])
          && data.fromUid == request.auth.uid
          && data.offeredAt == request.time;
      }

      // Accepting: only the acceptance is added, by the caller, while the
      // offer is open, together with the owner record naming the caller.
      function isAcceptance() {
        let data = request.resource.data;
        return !('acceptedBy' in resource.data)
          && request.time < resource.data.offeredAt + duration.value(7, 'd')
          && data.diff(resource.data).affectedKeys()
            .hasOnly(['acceptedBy', 'acceptedAt'])
          && data.acceptedBy == request.auth.uid
          && data.acceptedAt == request.time
          && exists(listPath(shareCode))
          && getAfter(ownerPath(shareCode)).data.ownerUid == request.auth.uid
          && getAfter(ownerPath(shareCode)).data.get('handover', '') == token;
      }

      function isOwnOffer() {
        return signedIn() && resource.data.fromUid == request.auth.uid;
      }

      allow get, list: if isOwnOffer() || isOwner(shareCode);
      allow create: if isShareCode(shareCode)
        && isHandoverCode(token)
        && signedIn()
        && isOwner(shareCode)
        && isOffer(request.resource.data);
      allow update: if signedIn() && notBlocked() && isAcceptance();
      allow delete: if isOwnOffer() || isOwner(shareCode);
    }

    // One subscribing phone, named by its random id for this list
    // (SubscriptionStorage.generateSubscriptionId: 32 characters).
    match /sharedLists/{shareCode}/subscriptions/{subscriptionId} {
      function isSubscription(data) {
        return data.keys().hasOnly(['seenAt', 'appToken'])
          && data.keys().hasAll(['seenAt', 'appToken'])
          && data.seenAt == request.time
          && hasAppToken(data);
      }

      // Only a phone that may read the list counts towards it.
      function mayRead() {
        return exists(listPath(shareCode))
          && (!get(listPath(shareCode)).data.list.get('membersOnly', false)
            || isMember(shareCode));
      }

      function isSubscriptionId() {
        return subscriptionId.matches('^[A-Za-z0-9_-]{32}$');
      }

      allow get: if false;
      allow list: if isShareCode(shareCode) && isOwner(shareCode);
      allow create, update: if isShareCode(shareCode)
        && isSubscriptionId()
        && isSubscription(request.resource.data)
        && mayRead();
      allow delete: if isShareCode(shareCode)
        && (isSubscriptionId() || isOwner(shareCode));
    }

    // A report about a published list (ReportService.reportList).
    match /reports/{reportId} {
      function isReport(data) {
        return data.keys().hasOnly(['shareCode', 'reporterUid', 'reason',
            'details', 'contact', 'createdAt', 'appToken'])
          && data.keys().hasAll(['shareCode', 'reporterUid', 'reason',
            'createdAt', 'appToken'])
          && data.shareCode is string
          && isShareCode(data.shareCode)
          && reportId == data.shareCode + '_' + request.auth.uid
          && data.reporterUid == request.auth.uid
          && data.reason in ['consent', 'child', 'copyright', 'illegal',
            'spam', 'other']
          && (!('details' in data)
            || (data.details is string
              && data.details.size() > 0
              && data.details.size() <= 2000))
          && (!('contact' in data)
            || (data.contact is string
              && data.contact.size() > 0
              && data.contact.size() <= 254))
          && data.createdAt == request.time
          && hasAppToken(data);
      }

      allow read, delete: if false;
      allow create, update: if signedIn()
        && notBlocked()
        && isReport(request.resource.data)
        && exists(listPath(request.resource.data.shareCode));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
